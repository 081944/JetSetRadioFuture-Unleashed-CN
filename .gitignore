# Built from launcher/icon/AppIcon.iconset by launcher/build_app.sh
launcher/AppIcon.icns

# Builds of the game (see port/CMakeLists.txt) and packaged apps.
# Directory rule (tools/cn_compat/README.md): build/ holds every APK-side output
#   build/work/  scratch, deleted after each packaging run
#   build/dist/  shipped artifacts, one directory per version
#   build/signing/  keystore + password
#   build/logs/  build logs and archives
# build-cn-native/ is the cached CMake tree for libmain.so.
/build*/
*.app/
*.tar.gz
*.zip
*.ipa

# The generated code: derived from the game's executable, never committed
port/recomp/

# Backups and merge leftovers
*.bak*
*.orig

# CN development: local game-derived profiles and private signing material
/analysis/
/Media/
cn_profile.h
cn_codegen.sha256
*.apk
*.aab
*.idsig
*.keystore
*.jks
*.p12
*.pfx
*.pass
*.dex
*.class
*.so
*.a
*.o
.env
.env.*
